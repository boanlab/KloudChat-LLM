# Only the engines named below exist; nothing arrives with the defaults. The
# audience is a Korean university (students and researchers across faculties,
# office and research staff), and this host's address is one datacentre IP that
# google, bing, duckduckgo, naver and most smaller scrapers refuse, so the set
# is what answers from here and what this audience asks for. Re-measured
# 2026-09-11; to re-test an engine:
#
#   curl -s -G 'http://<host>/tools/search/search' --data-urlencode 'q=<query>' \
#     -d format=json -d engines=<name> | python3 -c 'import sys,json; \
#     d=json.load(sys.stdin); print(len(d["results"]), d["unresponsive_engines"])'
use_default_settings:
  engines:
    keep_only:
      # general
      - yandex
      - brave
      - wikipedia
      - openlibrary
      # news
      - duckduckgo news
      - bing news
      - reuters
      # science
      - google scholar
      - openalex
      - semantic scholar
      - arxiv
      - pubmed
      - openairepublications
      # it
      - github
      - stackoverflow
      - mdn
      - docker hub
      - microsoft learn
      - huggingface

search:
  # Language and region: engines that take a market or country prefer Korean
  # results with the region present. Applies when a request carries no language.
  default_lang: "ko-KR"
  # Strict. The search shim also forces safesearch=2 on every request it forwards.
  safe_search: 2
  # HTML-page suggestions only; every provider is blocked from this address
  autocomplete: ""
  ban_time_on_fail: 5
  max_ban_time_on_fail: 120
  # Engine suspension after a block. The defaults (CAPTCHA: an hour) turn one
  # burst into an hour without general search for everyone, and the suspension
  # is shared by all workers through valkey. Short enough to recover on its
  # own; the search shim's cache and cap keep the bursts from happening.
  suspended_times:
    SearxEngineAccessDenied: 120
    SearxEngineCaptcha: 300
    SearxEngineTooManyRequests: 120
    # Cloudflare and reCAPTCHA challenges (brave sits behind Cloudflare); the
    # defaults are 15, 1 and 7 days.
    cf_SearxEngineCaptcha: 600
    cf_SearxEngineAccessDenied: 300
    recaptcha_SearxEngineCaptcha: 600
  default_doi_resolver: sci-hub.se
  formats:
    - html
    - json

server:
  # Sentinel replaced by gen-searxng-config.sh with SEARXNG_SECRET_KEY from .env
  secret_key: "__SEARXNG_SECRET_KEY__"
  bind_address: "0.0.0.0"
  port: 8080
  image_proxy: true
  method: POST
  limiter: false

valkey:
  url: valkey://valkey:6379/0

ui:
  results_per_page: 15
  infinite_scroll: true

outgoing:
  request_timeout: 4.0
  max_request_timeout: 15.0
  useragent_suffix: "searxng@localhost.localdomain"
  pool_connections: 100
  pool_maxsize: 30
  keepalive_expiry: 10.0
  enable_http2: false

categories_as_tabs:
  general:
  news:
  science:
  it:

engines:

  # ── general: everyday, administrative and business questions ────────
  # yandex is the one scraped engine that answers Korean everyday queries
  # from this address (Naver blogs, 지식iN, news sites; 15/15 on-topic).
  # brave answers well (17/20) but is rate-limited and often suspended, so
  # it adds when present. bing answered with TikTok and Microsoft home
  # pages for anything, google/duckduckgo/naver/startpage/qwant/mojeek/
  # presearch/yep/ask/aol/seznam/mwmbl/karmasearch/yahoo return nothing.
  # Off in SearXNG's defaults
  - name: yandex
    weight: 1.5
    timeout: 6.0
    disabled: false

  - name: brave
    weight: 1.0
    timeout: 6.0

  - name: wikipedia
    weight: 0.8

  # Books, for the humanities. An API on its own host.
  - name: openlibrary
    weight: 0.3
    disabled: false

  # ── news: current events; the UI's news lane ────────────────────────
  # Korean news: duckduckgo news 22/22, bing news 9/9. google news, yahoo
  # news, qwant news, yep news, mojeek news, startpage news, karmasearch
  # news and wikinews return nothing. reuters is English only.
  - name: duckduckgo news
    weight: 1.2
    timeout: 6.0

  - name: bing news
    weight: 1.0
    timeout: 6.0

  - name: reuters
    weight: 0.6
    timeout: 6.0

  # ── science: graduate students, researchers; the UI's papers lane ───
  # All answered 10/10 for English and Korean topics. crossref answered a
  # Korean education query with 1/20 on-topic and is left out; openaire
  # datasets and pdbe return nothing.
  - name: google scholar
    weight: 1.2
    timeout: 8.0

  - name: openalex
    weight: 1.0
    timeout: 8.0
    disabled: false

  - name: semantic scholar
    weight: 1.0
    timeout: 8.0

  - name: arxiv
    weight: 0.8
    timeout: 6.0

  - name: pubmed
    weight: 0.6
    timeout: 8.0

  - name: openairepublications
    weight: 0.6
    timeout: 8.0

  # ── it: engineering; the UI's code lane ─────────────────────────────
  # pypi, askubuntu, superuser, hackernews and reddit return nothing.
  - name: github
    weight: 1.2

  - name: stackoverflow
    weight: 1.2

  - name: mdn
    weight: 0.8

  - name: docker hub
    weight: 0.6

  - name: microsoft learn
    weight: 0.8
    disabled: false

  - name: huggingface
    weight: 0.6
    disabled: false

  # ── NAVER Search API (NAVER API HUB) ─────────────────────────────────
  # Not the scraping `naver` engine above (blocked from this network) but the
  # Search API, through SearXNG's generic JSON engine. The Korean web as Korean
  # users see it — web documents and news — from the source. Since 2026-06 the
  # API is served by NAVER API HUB on NAVER Cloud Platform
  # (naverapihub.apigw.ntruss.com, X-NCP-APIGW-* headers); the developers.naver.com
  # endpoints stop for new applications on 2026-07-31 and for everyone on
  # 2027-06-30. Quota: the search APIs share 775,000 calls a month per
  # application at 50 requests a second per key, free at present; a search costs
  # one call per engine below. Each API (웹문서, 뉴스) must be enabled on the
  # application in the NCP console or the HUB answers 401 "활성화되어 있지 않습니다".
  # gen-searxng-config.sh fills the credentials from NAVER_CLIENT_ID /
  # NAVER_CLIENT_SECRET in .env and enables the two engines only when both
  # are set; without them they stay disabled and cost nothing.
  - name: naver web
    engine: json_engine
    shortcut: nvw
    categories: [general]
    paging: false
    search_url: https://naverapihub.apigw.ntruss.com/search/v1/webkr?query={query}&display=10
    headers:
      X-NCP-APIGW-API-KEY-ID: "__NAVER_CLIENT_ID__"
      X-NCP-APIGW-API-KEY: "__NAVER_CLIENT_SECRET__"
    results_query: items
    url_query: link
    title_query: title
    content_query: description
    title_html_to_text: true
    content_html_to_text: true
    weight: 2.0
    timeout: 5.0
    disabled: __NAVER_DISABLED__

  - name: naver news
    engine: json_engine
    shortcut: nvn
    categories: [news]
    paging: false
    search_url: https://naverapihub.apigw.ntruss.com/search/v1/news?query={query}&display=10&sort=date
    headers:
      X-NCP-APIGW-API-KEY-ID: "__NAVER_CLIENT_ID__"
      X-NCP-APIGW-API-KEY: "__NAVER_CLIENT_SECRET__"
    results_query: items
    url_query: originallink
    title_query: title
    content_query: description
    title_html_to_text: true
    content_html_to_text: true
    weight: 2.0
    timeout: 5.0
    disabled: __NAVER_DISABLED__
