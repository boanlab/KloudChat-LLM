use_default_settings: true

search:
  default_lang: ko
  safe_search: 0
  # duckduckgo autocomplete is behind a CAPTCHA
  autocomplete: google
  ban_time_on_fail: 5
  max_ban_time_on_fail: 120
  default_doi_resolver: sci-hub.se
  formats:
    - html
    - json

server:
  # Sentinel replaced by gen-searxng-config.sh with SEARXNG_SECRET_KEY from .env
  secret_key: "__SEARXNG_SECRET_KEY__"
  bind_address: "0.0.0.0"
  port: 8080
  image_proxy: true
  method: POST
  limiter: false

valkey:
  url: valkey://valkey:6379/0

ui:
  results_per_page: 15
  infinite_scroll: true

outgoing:
  request_timeout: 4.0
  max_request_timeout: 15.0
  useragent_suffix: "searxng@localhost.localdomain"
  pool_connections: 100
  pool_maxsize: 30
  keepalive_expiry: 10.0
  enable_http2: false

categories_as_tabs:
  general:
  science:
  images:
  videos:
  news:
  it:

# General search runs on scraping. An engine that blocks datacenter IPs returns
# zero results with HTTP 200, so only engines that answer from this network are
# enabled; a dead one costs a timeout per query. To re-test an engine:
#
#   curl -s 'http://<host>/search?q=kubernetes+security&format=json&engines=bing' \
#     | python3 -c 'import sys,json; d=json.load(sys.stdin); \
#         print(len(d["results"]), d["unresponsive_engines"])'
engines:

  # General search. Re-measured 2026-09-08 with a throwaway instance on this
  # network, six Korean everyday queries (medicine, minimum wage, scholarship
  # dates, a paediatrician, a model name, train fares) plus four English
  # developer queries, scored on results carrying the query words:
  #   yandex      6/6 Korean, 4/4 English — Naver blogs, 지식iN, 아하, news sites
  #   bing        1/6 Korean, 0/4 English — home pages, dictionaries, Baidu junk
  #   yahoo       suspended (HTTP protocol error)
  #   google/naver/duckduckgo/startpage/brave/mojeek/qwant/presearch  blocked
  # bing stays as a fallback at low weight: KloudChat re-ranks by query-word
  # overlap, so its off-topic hits sink under yandex's when both answer.
  - name: yandex
    weight: 1.5
    timeout: 6.0
    categories: [general]
    disabled: false

  - name: bing
    weight: 0.5
    timeout: 6.0
    categories: [general]
    disabled: false

  - name: yahoo
    weight: 1.0
    timeout: 6.0
    categories: [general]
    disabled: false

  # Blocked from this network (consent page, CAPTCHA, or zero results).
  # Re-test with the curl above before enabling.
  - name: google
    weight: 1.5
    timeout: 6.0
    disabled: true

  - name: google english
    engine: google
    shortcut: goen
    language: en
    weight: 1.3
    timeout: 6.0
    categories: [general]
    disabled: true

  - name: duckduckgo
    weight: 1.0
    disabled: true

  - name: google scholar
    shortcut: gs
    categories: [science]
    weight: 0.8
    timeout: 8.0
    disabled: false

  - name: arxiv
    shortcut: arx
    categories: [science]
    weight: 0.8
    timeout: 6.0
    disabled: false

  - name: semantic scholar
    shortcut: se
    categories: [science]
    weight: 0.7
    timeout: 8.0
    disabled: false

  - name: openalex
    shortcut: oa
    categories: [science]
    weight: 0.6
    timeout: 8.0
    disabled: false

  - name: crossref
    shortcut: cr
    categories: [science]
    weight: 0.4
    timeout: 10.0
    disabled: false

  - name: pubmed
    shortcut: pm
    categories: [science]
    weight: 0.6
    timeout: 8.0
    disabled: false

  # Best source for Korean results when it answers; raise the weight if it does.
  - name: naver
    weight: 0.5
    categories: [general]
    disabled: true

  - name: wikipedia
    weight: 1.0
    disabled: false
