# Only the engines named below; none of SearXNG's defaults. Chosen for a Korean
# university audience and for answering from a datacentre IP (google, bing,
# duckduckgo web, naver scraping and most smaller scrapers refuse it). To test
# an engine:
#
#   curl -s -G 'http://<host>/tools/search/search' --data-urlencode 'q=<query>' \
#     -d format=json -d engines=<name> | python3 -c 'import sys,json; \
#     d=json.load(sys.stdin); print(len(d["results"]), d["unresponsive_engines"])'
use_default_settings:
  engines:
    keep_only:
      # general
      - yandex
      - brave
      - wikipedia
      - openlibrary
      # news
      - duckduckgo news
      - bing news
      - reuters
      # science
      - google scholar
      - openalex
      - semantic scholar
      - arxiv
      - pubmed
      - openairepublications
      # it
      - github
      - stackoverflow
      - mdn
      - docker hub
      - microsoft learn
      - huggingface

search:
  # Default language; market/country engines need the region for Korean results
  default_lang: "ko-KR"
  # Strict; the search shim also forces it per request
  safe_search: 2
  # Off: every provider blocks this address
  autocomplete: ""
  ban_time_on_fail: 5
  max_ban_time_on_fail: 120
  # Engine suspension after a block (seconds), shared through valkey; shorter than SearXNG's defaults
  suspended_times:
    SearxEngineAccessDenied: 120
    SearxEngineCaptcha: 300
    SearxEngineTooManyRequests: 120
    # Cloudflare (brave) and reCAPTCHA challenges
    cf_SearxEngineCaptcha: 600
    cf_SearxEngineAccessDenied: 300
    recaptcha_SearxEngineCaptcha: 600
  default_doi_resolver: sci-hub.se
  formats:
    - html
    - json

server:
  # Sentinel replaced by gen-searxng-config.sh with SEARXNG_SECRET_KEY from .env
  secret_key: "__SEARXNG_SECRET_KEY__"
  bind_address: "0.0.0.0"
  port: 8080
  image_proxy: true
  method: POST
  limiter: false

valkey:
  url: valkey://valkey:6379/0

ui:
  results_per_page: 15
  infinite_scroll: true

outgoing:
  request_timeout: 4.0
  max_request_timeout: 15.0
  useragent_suffix: "searxng@localhost.localdomain"
  pool_connections: 100
  pool_maxsize: 30
  keepalive_expiry: 10.0
  enable_http2: false

categories_as_tabs:
  general:
  news:
  science:
  it:

engines:

  # ── general: everyday, administrative and business questions ────────
  # yandex: scraped engine that answers Korean everyday queries from this
  # address; off in SearXNG's defaults. brave: rate-limited, often suspended.
  - name: yandex
    weight: 1.5
    timeout: 6.0
    disabled: false

  - name: brave
    weight: 1.0
    timeout: 6.0

  - name: wikipedia
    weight: 0.8

  # Books (humanities)
  - name: openlibrary
    weight: 0.3
    disabled: false

  # ── news: current events; the UI's news lane ────────────────────────
  # duckduckgo news and bing news answer Korean news; reuters is English only.
  - name: duckduckgo news
    weight: 1.2
    timeout: 6.0

  - name: bing news
    weight: 1.0
    timeout: 6.0

  - name: reuters
    weight: 0.6
    timeout: 6.0

  # ── science: graduate students, researchers; the UI's papers lane ───
  # All answer English and Korean topics.
  - name: google scholar
    weight: 1.2
    timeout: 8.0

  - name: openalex
    weight: 1.0
    timeout: 8.0
    disabled: false

  - name: semantic scholar
    weight: 1.0
    timeout: 8.0

  - name: arxiv
    weight: 0.8
    timeout: 6.0

  - name: pubmed
    weight: 0.6
    timeout: 8.0

  - name: openairepublications
    weight: 0.6
    timeout: 8.0

  # ── it: engineering; the UI's code lane ─────────────────────────────
  - name: github
    weight: 1.2

  - name: stackoverflow
    weight: 1.2

  - name: mdn
    weight: 0.8

  - name: docker hub
    weight: 0.6

  - name: microsoft learn
    weight: 0.8
    disabled: false

  - name: huggingface
    weight: 0.6
    disabled: false

  # ── NAVER Search API (NAVER API HUB) ─────────────────────────────────
  # Via SearXNG's generic JSON engine (the scraping `naver` engine is blocked
  # here). NAVER Cloud Platform API HUB, X-NCP-APIGW-* headers. Quota: 775,000
  # calls/month per application, 50 req/s per key, one call per engine per
  # search. Each API (웹문서, 뉴스) must be enabled in the NCP console, else 401.
  # gen-searxng-config.sh fills NAVER_CLIENT_ID / NAVER_CLIENT_SECRET and enables
  # both engines only when both are set.
  - name: naver web
    engine: json_engine
    shortcut: nvw
    categories: [general]
    paging: false
    search_url: https://naverapihub.apigw.ntruss.com/search/v1/webkr?query={query}&display=10
    headers:
      X-NCP-APIGW-API-KEY-ID: "__NAVER_CLIENT_ID__"
      X-NCP-APIGW-API-KEY: "__NAVER_CLIENT_SECRET__"
    results_query: items
    url_query: link
    title_query: title
    content_query: description
    title_html_to_text: true
    content_html_to_text: true
    weight: 2.0
    timeout: 5.0
    disabled: __NAVER_DISABLED__

  - name: naver news
    engine: json_engine
    shortcut: nvn
    categories: [news]
    paging: false
    # sort=sim: relevance order
    search_url: https://naverapihub.apigw.ntruss.com/search/v1/news?query={query}&display=10&sort=sim
    headers:
      X-NCP-APIGW-API-KEY-ID: "__NAVER_CLIENT_ID__"
      X-NCP-APIGW-API-KEY: "__NAVER_CLIENT_SECRET__"
    results_query: items
    url_query: originallink
    title_query: title
    content_query: description
    title_html_to_text: true
    content_html_to_text: true
    weight: 2.0
    timeout: 5.0
    disabled: __NAVER_DISABLED__
