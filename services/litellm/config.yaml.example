model_list:
  # >>> KLOUDCHAT_AUTOGEN_START
  #
  # Generated by ./scripts/gen-litellm-config.sh from the vLLM backend URLs in
  # .env. Everything between the markers is overwritten.
  #
  # max_input_tokens comes from each backend's /v1/models (max_model_len), so
  # per-node contexts are reflected automatically; CTX_FALLBACK applies when
  # discovery fails. local/* deployments carry
  # model_info.supports_function_calling: true, which makes the UI issue native
  # tool calls instead of ReAct text.
  #
  # <<< KLOUDCHAT_AUTOGEN_END


router_settings:
  num_retries: 2
  # 900s = 15 minutes. Deep research runs a thinking model through many LDR
  # steps, and a single call can exceed 10 minutes, so the per-call LLM timeout
  # is generous.
  timeout: 900
  # Load balancing across deployments registered under the same model_name, i.e.
  # several vLLM nodes. least-busy prefers the node with fewer requests in
  # flight, which is the natural fit for spreading GPU load.
  routing_strategy: least-busy
  # Check model_info.max_input_tokens up front and drop deployments whose limit
  # the request exceeds, which avoids a cooldown or a 503. When one model_name
  # spans nodes with different max_model_len, long prompts route themselves to
  # the node with the larger context.
  enable_pre_call_checks: true
  # Falls back to the same model on OpenRouter when a local node is down or
  # overloaded, once num_retries is exhausted. The target is the OpenRouter
  # deployment in the AUTOGEN block.
  #
  # Regenerated between the FALLBACKS markers by gen-litellm-config.sh. Editing it
  # by hand leaves the list stale on the next model rename.
  # >>> KLOUDCHAT_FALLBACKS_START
  fallbacks: []
  # <<< KLOUDCHAT_FALLBACKS_END

general_settings:
  master_key: os.environ/LITELLM_MASTER_KEY
  store_model_in_db: false
  # Usage and cost stay available, but request/response bodies never enter the
  # spend-log rows. Per-request message suppression from the client remains a
  # defence-in-depth signal rather than the only privacy control.
  store_prompts_in_spend_logs: false
  # Video Studio: the OpenRouter Video API (Veo, Sora) through LiteLLM, keeping
  # keys and egress central and billing per user. Submit is charged once per clip
  # through cost_per_request and attributed with x-litellm-end-user-id; polling
  # and download are separate, unbilled paths.
  #
  # One submit endpoint per model, resolution, audio and duration combination: a
  # passthrough cannot price dynamically, so each path carries a fixed cost, the
  # OpenRouter rate ($/s) times the duration.
  pass_through_endpoints:
    - { path: "/orvideo/submit/veo-lite/720p/a/4", target: "https://openrouter.ai/api/v1/videos", headers: { Authorization: "Bearer os.environ/OPENROUTER_API_KEY" }, forward_headers: false, cost_per_request: 0.2 }
    - { path: "/orvideo/submit/veo-lite/720p/a/6", target: "https://openrouter.ai/api/v1/videos", headers: { Authorization: "Bearer os.environ/OPENROUTER_API_KEY" }, forward_headers: false, cost_per_request: 0.3 }
    - { path: "/orvideo/submit/veo-lite/720p/a/8", target: "https://openrouter.ai/api/v1/videos", headers: { Authorization: "Bearer os.environ/OPENROUTER_API_KEY" }, forward_headers: false, cost_per_request: 0.4 }
    - { path: "/orvideo/submit/veo-lite/720p/na/4", target: "https://openrouter.ai/api/v1/videos", headers: { Authorization: "Bearer os.environ/OPENROUTER_API_KEY" }, forward_headers: false, cost_per_request: 0.12 }
    - { path: "/orvideo/submit/veo-lite/720p/na/6", target: "https://openrouter.ai/api/v1/videos", headers: { Authorization: "Bearer os.environ/OPENROUTER_API_KEY" }, forward_headers: false, cost_per_request: 0.18 }
    - { path: "/orvideo/submit/veo-lite/720p/na/8", target: "https://openrouter.ai/api/v1/videos", headers: { Authorization: "Bearer os.environ/OPENROUTER_API_KEY" }, forward_headers: false, cost_per_request: 0.24 }
    - { path: "/orvideo/submit/veo-lite/1080p/a/4", target: "https://openrouter.ai/api/v1/videos", headers: { Authorization: "Bearer os.environ/OPENROUTER_API_KEY" }, forward_headers: false, cost_per_request: 0.32 }
    - { path: "/orvideo/submit/veo-lite/1080p/a/6", target: "https://openrouter.ai/api/v1/videos", headers: { Authorization: "Bearer os.environ/OPENROUTER_API_KEY" }, forward_headers: false, cost_per_request: 0.48 }
    - { path: "/orvideo/submit/veo-lite/1080p/a/8", target: "https://openrouter.ai/api/v1/videos", headers: { Authorization: "Bearer os.environ/OPENROUTER_API_KEY" }, forward_headers: false, cost_per_request: 0.64 }
    - { path: "/orvideo/submit/veo-lite/1080p/na/4", target: "https://openrouter.ai/api/v1/videos", headers: { Authorization: "Bearer os.environ/OPENROUTER_API_KEY" }, forward_headers: false, cost_per_request: 0.2 }
