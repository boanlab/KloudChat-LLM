litellm_settings:
  # CustomLogger modules mounted at /app/callbacks/. Order does not matter.
  callbacks:
    # Rewrites a request to the model's OpenRouter twin once the local vLLM
    # exceeds its in-flight cap, spilling overload to OpenRouter to bound
    # latency. It polls num_requests_running and num_requests_waiting from vLLM's
    # /metrics in the background; caps are set through CONCURRENCY_GATE_CAPS.
    - "callbacks.concurrency_gate.gate_instance"
  drop_params: true
  drop_unsupported_params: true
  request_timeout: 900   # 15 minutes, for deep research's long calls (matches the router timeout)
  num_retries: 2
  check_provider_endpoint: false
  # Limits attach to the user: spend from every key that person holds aggregates
  # onto one ceiling. These are defaults for users the UI gave no budget.
  max_internal_user_budget: 25
  internal_user_budget_duration: "1mo"
  # Upper bounds for key creation. A key left without max_budget gets these
  # instead, and a key budget blocks before the user ceiling does — which is why
  # the UI clears it right after issuing a key.
  upperbound_key_generate_params:
    max_budget: 9999
    tpm_limit: 100000
    rpm_limit: 500

anthropic_proxy:
  enabled: true
  prefix: /
