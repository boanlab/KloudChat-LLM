# The only published entry point. Strips the path prefix and forwards to each
# service's root.
#
#   /litellm/*         → litellm root       (admin API included, Authorization passed through)
#   /tools/index/*     → index-shim         (RAG: chunk, embed, store, search)
#   /v1/*              → litellm /v1        (for OpenAI-compatible clients)
#   /tools/search/*    → search-shim        (cache and cap in front of searxng)
#   /tools/fetch/*     → crawl4ai-shim      (shim key injected)
#   /tools/exec/*      → code-interpreter   (x-api-key injected)
#   /tools/research/*  → deep-research      (MCP streamable-http)
#   /tools/stt/*       → whisper-shim
#
# /tools/* requires the shared key TOOLS_GATEWAY_KEY in the X-Tools-Key header;
# anything else gets 401 {"error":"unauthorized"} before any upstream is
# contacted. The header is stripped before proxying. Fail closed: compose
# refuses to start the gateway with TOOLS_GATEWAY_KEY unset or empty, and a key
# shorter than 32 characters denies every /tools request here as well. Use hex
# (`openssl rand -hex 32`): the value is substituted into a CEL string literal.
# /litellm* and /v1/* are authenticated by LiteLLM itself; /health is open.
# Service keys are injected here and never reach clients.
{
	admin off
	auto_https off
	log {
		output stdout
		format console
	}
}

:8080 {
	handle /health {
		header Content-Type application/json
		respond `{"status":"ok"}` 200
	}

	# LiteLLM root: admin API and UI, authenticated by LiteLLM with the master key
	handle_path /litellm* {
		reverse_proxy litellm:8000 {
			# Streamed responses forwarded immediately
			flush_interval -1
		}
	}

	# OpenAI-compatible clients
	handle /v1/* {
		reverse_proxy litellm:8000 {
			flush_interval -1
		}
	}

	handle /tools* {
		# Constant-time comparison is not available in Caddy; the key is 32+
		# random bytes and the comparison runs on the gateway host only.
		@authorized expression `{http.request.header.X-Tools-Key} == "{$TOOLS_GATEWAY_KEY}" && size("{$TOOLS_GATEWAY_KEY}") >= 32`

		handle @authorized {
			handle_path /tools/search* {
				reverse_proxy search-shim:8080 {
					header_up -X-Tools-Key
				}
			}

			handle_path /tools/fetch* {
				reverse_proxy crawl4ai-shim:8080 {
					header_up -X-Tools-Key
					header_up Authorization "Bearer {$SCRAPER_API_KEY}"
				}
			}

			handle_path /tools/exec* {
				reverse_proxy code-interpreter:8000 {
					header_up -X-Tools-Key
					header_up x-api-key "{$CODE_INTERPRETER_API_KEY}"
				}
			}

			handle_path /tools/research* {
				reverse_proxy deep-research:8081 {
					header_up -X-Tools-Key
					flush_interval -1
				}
			}

			handle_path /tools/stt* {
				reverse_proxy whisper-shim:9000 {
					header_up -X-Tools-Key
				}
			}

			handle_path /tools/index* {
				reverse_proxy index-shim:8080 {
					header_up -X-Tools-Key
				}
			}

			handle {
				header Content-Type application/json
				respond `{"error":"unknown path"}` 404
			}
		}

		handle {
			header Content-Type application/json
			respond `{"error":"unauthorized"}` 401
		}
	}

	handle {
		header Content-Type application/json
		respond `{"error":"unknown path"}` 404
	}
}
