# The only published entry point. Strips the path prefix and forwards to each
# service's root.
#
#   /litellm/*         → litellm root       (admin API included, Authorization passed through)
#   /v1/*              → litellm /v1        (OpenAI-compatible clients)
#   /tools/index/*     → index-shim         (RAG: chunk, embed, store, search)
#   /tools/search/*    → search-shim
#   /tools/fetch/*     → crawl4ai-shim      (shim key injected)
#   /tools/exec/*      → code-interpreter   (x-api-key injected)
#   /tools/research/*  → deep-research      (MCP streamable-http)
#   /tools/stt/*       → whisper-shim
#   /tools/ocr/*       → ocr-shim
#   /metrics/*         → metrics-shim       (GPU-node /metrics, read-only; /metrics/targets lists names)
#
# /tools/* and /metrics/* need TOOLS_GATEWAY_KEY in X-Tools-Key, else 401 before
# any upstream is contacted; the header is stripped before proxying. Fail
# closed: compose refuses an unset key and a key under 32 characters denies
# everything. Hex only (`openssl rand -hex 32`): the value goes into a CEL string
# literal. /litellm* and /v1/* are authenticated by LiteLLM; /health is open.
# Service keys are injected here and never reach clients. JSON-only tools have a
# body cap per route; uploads (exec, stt, ocr) are bounded by their services.
{
	admin off
	auto_https off
	log {
		output stdout
		format console
	}
}

:8080 {
	handle /health {
		header Content-Type application/json
		respond `{"status":"ok"}` 200
	}

	# LiteLLM root: admin API and UI, authenticated by LiteLLM with the master key
	handle_path /litellm* {
		reverse_proxy litellm:8000 {
			# Streamed responses forwarded immediately
			flush_interval -1
		}
	}

	# OpenAI-compatible clients
	handle /v1/* {
		reverse_proxy litellm:8000 {
			flush_interval -1
		}
	}

	handle /tools* {
		# Caddy has no constant-time comparison; the key is 32+ random bytes
		@authorized expression `{http.request.header.X-Tools-Key} == "{$TOOLS_GATEWAY_KEY}" && size("{$TOOLS_GATEWAY_KEY}") >= 32`

		handle @authorized {
			handle_path /tools/search* {
				request_body {
					max_size 1MB
				}
				reverse_proxy search-shim:8080 {
					header_up -X-Tools-Key
				}
			}

			handle_path /tools/fetch* {
				request_body {
					max_size 1MB
				}
				reverse_proxy crawl4ai-shim:8080 {
					header_up -X-Tools-Key
					header_up Authorization "Bearer {$SCRAPER_API_KEY}"
				}
			}

			handle_path /tools/exec* {
				reverse_proxy code-interpreter:8000 {
					header_up -X-Tools-Key
					header_up x-api-key "{$CODE_INTERPRETER_API_KEY}"
				}
			}

			handle_path /tools/research* {
				request_body {
					max_size 1MB
				}
				reverse_proxy deep-research:8081 {
					header_up -X-Tools-Key
					flush_interval -1
				}
			}

			handle_path /tools/stt* {
				reverse_proxy whisper-shim:9000 {
					header_up -X-Tools-Key
				}
			}

			handle_path /tools/index* {
				request_body {
					max_size 32MB
				}
				reverse_proxy index-shim:8080 {
					header_up -X-Tools-Key
				}
			}

			handle_path /tools/ocr* {
				reverse_proxy ocr-shim:8080 {
					header_up -X-Tools-Key
				}
			}

			handle {
				header Content-Type application/json
				respond `{"error":"unknown path"}` 404
			}
		}

		handle {
			header Content-Type application/json
			respond `{"error":"unauthorized"}` 401
		}
	}

	# GPU-node Prometheus text; the request never chooses the upstream
	handle /metrics/* {
		@metrics_authorized expression `{http.request.header.X-Tools-Key} == "{$TOOLS_GATEWAY_KEY}" && size("{$TOOLS_GATEWAY_KEY}") >= 32`

		handle @metrics_authorized {
			reverse_proxy metrics-shim:9200 {
				header_up -X-Tools-Key
			}
		}

		handle {
			header Content-Type application/json
			respond `{"error":"unauthorized"}` 401
		}
	}

	handle {
		header Content-Type application/json
		respond `{"error":"unknown path"}` 404
	}
}
