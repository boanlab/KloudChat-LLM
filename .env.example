# ━━━ 1. Filled in by you ━━━

# OpenRouter key: commercial models and the fallback for local ones. Required
# without a GPU node.
OPENROUTER_API_KEY=

# Hugging Face token for gated weight downloads
HF_TOKEN=

# GPU node SSH targets, comma separated (user@host or ssh_config alias). Empty
# skips node installation. The first target is the head node (retrieval,
# transcription); the rest are the pool (Flash-Next, the coder). Chat replicas
# land on any node with room.
# Example: NODES_VLLM=ops@gpu-1,ops@gpu-2
NODES_VLLM=

# Model ids to deploy, from scheduler/models.yaml. What does not fit a node is
# delegated to OpenRouter. qwen3.8-flash takes a pool node to itself, so it
# needs two nodes; on one node, leave it out (reachable as qwen/qwen3.8-flash).
VLLM_MODELS=qwen3.8-27b,qwen3.8-flash,bge-m3,bge-reranker-v2-m3,whisper-large-v3

# NAVER Search API credentials, issued by NAVER API HUB (NAVER Cloud Platform).
# Both set turns on the naver engines in SearXNG; empty leaves them disabled.
# Quota: 775,000 calls a month shared by the search APIs, 50 a second per key.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ━━━ 2. Exposure and sizing ━━━

# Gateway host port; the UI's backend URL is http://<this-host>:<port>
GATEWAY_PORT=8080

# Profiles: tools, models, index, whisper, ocr. setup.sh appends whisper once a
# transcription backend is placed.
COMPOSE_PROFILES=tools,models

# LiteLLM workers, ~600 MB of RAM each
LITELLM_NUM_WORKERS=4

# ━━━ 3. Secrets (gen-env.sh replaces every change-me-* with a random value) ━━━

SEARXNG_SECRET_KEY=change-me-searxng-secret

LITELLM_DB_USER=kloudchat-litellm
LITELLM_DB_PASSWORD=change-me-litellm-db-password
LITELLM_MASTER_KEY=change-me-litellm-master-key

# Required by the gateway on every /tools/* request (header X-Tools-Key).
# KloudChat's API sends it: set the same value there as KCHAT_TOOLS_GATEWAY_KEY.
# Hex only (gen-env.sh writes 64 hex chars; by hand: openssl rand -hex 32).
# At least 32 characters, or the gateway denies every /tools request.
TOOLS_GATEWAY_KEY=change-me-tools-gateway-key

# Injected by the gateway into code execution requests
CODE_INTERPRETER_API_KEY=change-me-code-interpreter-key
CODE_INTERPRETER_MINIO_USER=code-interpreter
CODE_INTERPRETER_MINIO_PASSWORD=change-me-minio-password
CODE_INTERPRETER_MINIO_BUCKET=code-interpreter

# Injected by the gateway into document fetch requests
SCRAPER_API_KEY=change-me-scraper-key

# ━━━ 4. Backend URLs — written by the scheduler from placement results ━━━

# Transcription backends; empty routes STT to OpenRouter
WHISPER_URLS=

# Self-hosted image models (vllm-omni), served name=URL without /v1, comma-separated;
# set, it starts imagegen-shim (profile imagegen) and registers each name in LiteLLM
# as strict-local/<name> only (pictures never leave the boundary).
# e.g. IMAGEGEN_BACKENDS=local/z-image-turbo=http://gpu-2:8091 → strict-local/z-image-turbo
# The node runs them with ./scripts/manage-vllm-omni.sh (docker-compose.vllm-omni.yml).
IMAGEGEN_BACKENDS=

# CSV of http://host:port, without /v1 (the generator appends it),
# e.g. VLLM_QWENFLASH_URL=http://gpu-2:8004
VLLM_QWEN27B_URL=
VLLM_QWENFLASH_URL=
VLLM_CODERNEXT_URL=
VLLM_BGEM3_URL=
VLLM_RERANK_URL=

# KloudChat's performance page reads these through the gateway's /metrics/*
# (X-Tools-Key). One http://host:port each, no path and no list: the vLLM
# server of each model, and gpu-exporter (docker-compose.vllm.yml, :9835) on
# each GPU node, the head node as GPU_1. Empty: that card shows no data.
METRICS_VLLM_27B_URL=
METRICS_VLLM_FLASHNEXT_URL=
METRICS_VLLM_BGEM3_URL=
METRICS_VLLM_RERANK_URL=
METRICS_VLLM_WHISPER_URL=
METRICS_GPU_1_URL=
METRICS_GPU_2_URL=

# ━━━ 5. Images ━━━

# Images are pulled as <NS>/kloudchat-*:<TAG>
KLOUDCHAT_IMAGE_NS=boanlab
KLOUDCHAT_IMAGE_TAG=latest

# ━━━ 6. GPU node startup options ━━━
#
# MAX_LEN and GPU_UTIL are written per node by the placement step; the values
# here apply when placement is skipped. See docs/gpu-memory.md.

# vLLM image on the node (install-vllm.sh; default kloudchat-vllm:local), its
# upstream base and the base's resolved digest
VLLM_IMAGE=
VLLM_BASE_IMAGE=
VLLM_BASE_DIGEST=
VLLM_MODELS_ROOT=/var/lib/vllm/models

# Default chat. NVFP4; 32 KiB of KV per token (fp8)
VLLM_QWEN27B_DIR=qwen3.8-27b-nvfp4
VLLM_QWEN27B_GPU_UTIL=0.55
VLLM_QWEN27B_MAX_LEN=262144
VLLM_QWEN27B_MAX_BATCHED_TOKENS=16384
VLLM_QWEN27B_MAX_NUM_SEQS=128
# MTP speculative tokens per step
VLLM_QWEN27B_SPEC_TOKENS=5

# Quality and judging. MoE, NVFP4 body, FP8 PLE table off the GPU; 12 KiB of KV
# per token (fp8); a GB10 or RTX PRO 6000 node to itself
VLLM_QWENFLASH_DIR=qwen3.8-flash-next-nvfp4
VLLM_QWENFLASH_GPU_UTIL=0.81
VLLM_QWENFLASH_MAX_LEN=131072
VLLM_QWENFLASH_MAX_BATCHED_TOKENS=16384
VLLM_QWENFLASH_MAX_NUM_SEQS=16
# MTP speculative tokens per step
VLLM_QWENFLASH_SPEC_TOKENS=2
# PLE table storage (--engram-config). Empty: mapped from the checkpoint (GB10);
# {} on a discrete card (pinned host RAM), written by install-vllm.sh
VLLM_QWENFLASH_ENGRAM=

# Coding, larger. Hybrid attention, 12 KiB of KV per token; native 262K
VLLM_CODERNEXT_DIR=qwen3-coder-next
VLLM_CODERNEXT_GPU_UTIL=0.85
VLLM_CODERNEXT_MAX_LEN=262144

# Transcription (openai/whisper-large-v3 on vLLM); upload ceiling in MB
VLLM_WHISPER_DIR=whisper-large-v3
WHISPER_MAX_UPLOAD_MB=100

# Self-hosted image models (docker-compose.vllm-omni.yml, manage-vllm-omni.sh):
# vllm-omni image, checkpoint directories under VLLM_MODELS_ROOT, and the cards
# they see. z-image-turbo serves on :8091, qwen-image-2512 on :8092.
VLLM_OMNI_IMAGE=vllm/vllm-omni:v0.30.0
VLLM_OMNI_ZIMAGE_DIR=z-image-turbo
VLLM_OMNI_QWENIMAGE_DIR=qwen-image-2512
VLLM_OMNI_DEVICES=all

# ━━━ 7. Deep research ━━━

# Model for iterative search; served at its native 256K context
DEEP_RESEARCH_MODEL=local/qwen3.8-27b

# ━━━ 8. Retrieval index (profile: index) ━━━

# pgvector database for KloudChat's RAG. Without the profile KloudChat uses
# lexical search.
INDEX_DB_USER=index
INDEX_DB_PASSWORD=change-me-index-db-password
# Embedding models in preference order
INDEX_EMBED_MODELS=local/bge-m3,text-embedding-3-small

# ━━━ 9. Text from scanned pages (profile: ocr) ━━━

# PaddleOCR PP-OCRv5 (Korean) on CPU. KloudChat sends scanned PDF pages and
# document photos here; a page it cannot read with confidence goes to a
# strict-local vision model through LiteLLM, chosen in KloudChat's admin screen.
# Cores the service may use, pages read at once, ONNX threads per page
OCR_CPUS=4
OCR_CONCURRENCY=1
OCR_THREADS=4
# Memory cap, largest accepted document, render resolution
OCR_MEM_LIMIT=3g
OCR_MAX_BODY_MB=64
OCR_DPI=200
