# ━━━ 1. Filled in by you ━━━

# OpenRouter key for commercial models. Required without a local GPU, and
# recommended with one so that local models have somewhere to fall back to.
OPENROUTER_API_KEY=

# Hugging Face token for gated repositories (vLLM and whisper weight downloads).
HF_TOKEN=

# GPU node SSH targets, comma separated — user@host or an ssh_config alias.
# Empty skips node installation. This is the only node list: every node runs both
# vLLM and, on amd64, the transcription backend.
# Example: NODES_VLLM=ops@gpu-1,ops@gpu-2
NODES_VLLM=

# Model ids to deploy. The scheduler spreads them across the available nodes and
# delegates whatever does not fit to OpenRouter. Defined in scheduler/models.yaml.
VLLM_MODELS=qwen3.5-122b-a10b,qwen3.6-35b,glm-4.7-flash,gemma-4-26b-a4b,qwen3-coder-30b,qwen3.6-27b,bge-m3

# ━━━ 2. Exposure ━━━

# Gateway host port. The address for the UI admin screen is http://<this-host>:<port>.
GATEWAY_PORT=8080

# Profiles to start: tools (gateway + tools), models (LiteLLM),
# whisper (transcription shim). setup.sh appends whisper once a transcription
# backend answers, since the GPU nodes are that backend.
COMPOSE_PROFILES=tools,models

# ━━━ 3. Secrets (gen-env.sh replaces every change-me-* with a random value) ━━━

SEARXNG_SECRET_KEY=change-me-searxng-secret

LITELLM_DB_USER=kloudchat-litellm
LITELLM_DB_PASSWORD=change-me-litellm-db-password
LITELLM_MASTER_KEY=change-me-litellm-master-key
LITELLM_NUM_WORKERS=4

# Injected by the gateway into code execution requests — callers never see it.
CODE_INTERPRETER_API_KEY=change-me-code-interpreter-key
CODE_INTERPRETER_MINIO_USER=code-interpreter
CODE_INTERPRETER_MINIO_PASSWORD=change-me-minio-password
CODE_INTERPRETER_MINIO_BUCKET=code-interpreter

# Document fetch shim key, also injected by the gateway.
SCRAPER_API_KEY=internal-shim-noauth

# ━━━ 4. Backend URLs — refreshed by the scheduler from placement results ━━━

# Transcription backends. The value below is the single-node fallback; with
# several nodes, the placement step records **only the backends that answered**.
# Empty sends STT to OpenRouter (voxtral), which is what an arm64-only cluster
# ends up doing.
WHISPER_URLS=http://host.docker.internal:9000

VLLM_QWEN35B_URL=
VLLM_GLMFLASH_URL=
VLLM_QWEN122B_URL=
VLLM_GEMMA26B_URL=
VLLM_CODER30B_URL=
VLLM_QWEN27B_URL=

# ━━━ 5. Images ━━━

# boanlab/kloudchat-*. Change the namespace to publish elsewhere,
# for example ghcr.io/your-org.
KLOUDCHAT_IMAGE_NS=boanlab
KLOUDCHAT_IMAGE_TAG=latest

# ━━━ 6. GPU node startup options (vLLM and transcription) ━━━
#
# MAX_LEN and GPU_UTIL are computed per node by the placement step and overwritten
# there; the values below apply when placement is skipped. The reasoning behind
# them is in docs/gpu-memory.md under "Tuning knobs".

# Empty uses the compose default, the arm64 (GB10) *-aarch64 image. amd64 GPUs
# must name the standard image — install-vllm.sh records it here.
# What compose runs: this repo's layer over the upstream vLLM image, built by
# install-vllm.sh. Left empty it defaults to kloudchat-vllm:local.
VLLM_IMAGE=
# The upstream image it was built from, and the digest that tag resolved to.
# install-vllm.sh records both so a rebuild reproduces the same vLLM rather than
# whatever `nightly` is that day — a moving base once relocated the tool-parser
# registry, which leaves containers healthy and tool calls silently unparsed.
VLLM_BASE_IMAGE=
VLLM_BASE_DIGEST=
VLLM_MODELS_ROOT=/var/lib/vllm/models

# Unified chat — NVFP4 only. KV costs 10 KiB per token, so a 256K window is 2.5 GiB.
VLLM_QWEN35B_DIR=qwen3.6-35b-nvfp4
VLLM_QWEN35B_GPU_UTIL=0.55
VLLM_QWEN35B_MAX_LEN=262144
VLLM_QWEN35B_MAX_BATCHED_TOKENS=16384
VLLM_QWEN35B_MAX_NUM_SEQS=128

# Top chat — 78 GiB of weights, so it wants the card to itself. 128K rather than
# the native 262K: what remains for KV after the weights is ~22 GiB, and at
# 12 KiB per token that is ~13 concurrent requests at 128K.
VLLM_QWEN122B_DIR=qwen3.5-122b-a10b
VLLM_QWEN122B_GPU_UTIL=0.85
VLLM_QWEN122B_MAX_LEN=131072
VLLM_QWEN122B_MAX_BATCHED_TOKENS=16384
VLLM_QWEN122B_MAX_NUM_SEQS=32
# Cards to shard across on one host. The scheduler writes this from
# models.yaml's tensor_parallel; 1 is a single card. 78 GiB of weights does not
# fit a 96 GB card whole, so a PRO 6000 host needs 2 here — and then two cards
# serve this model and nothing else.
VLLM_QWEN122B_TP=1

# Cheap-decode floor.
VLLM_GLMFLASH_DIR=glm-4.7-flash
VLLM_GLMFLASH_GPU_UTIL=0.65
VLLM_GLMFLASH_MAX_LEN=131072
VLLM_GLMFLASH_MAX_BATCHED_TOKENS=16384

# A second family — vision and tool calling. Five layers in six are
# sliding-window (1024 tokens), so a 256K context is far cheaper in KV than the
# layer count suggests.
VLLM_GEMMA26B_DIR=gemma-4-26b
VLLM_GEMMA26B_GPU_UTIL=0.45
VLLM_GEMMA26B_MAX_LEN=262144
VLLM_GEMMA26B_MAX_BATCHED_TOKENS=16384

# Coding. 48 full-attention layers at 48 KiB/token — the most KV-expensive
# model here, which is why its context is capped well below native.
VLLM_CODER30B_DIR=qwen3-coder-30b
VLLM_CODER30B_GPU_UTIL=0.60
VLLM_CODER30B_MAX_LEN=131072

# The one dense model. 32 KiB/token.
VLLM_QWEN27B_DIR=qwen3.6-27b
VLLM_QWEN27B_GPU_UTIL=0.45
VLLM_QWEN27B_MAX_LEN=131072
VLLM_QWEN27B_MAX_BATCHED_TOKENS=16384

# Transcription on the same node (amd64 only — arm64 delegates STT to OpenRouter).
# The defaults are fine; only low-VRAM nodes need COMPUTE_TYPE lowered to int8.
# The planner reserves 6 GiB per node for this.
WHISPER_MODEL=large-v3
WHISPER_COMPUTE_TYPE=float16
WHISPER_PORT=9000

# ━━━ 7. Deep research ━━━

# Iterative search accumulates context across rounds, so this points at the
# 262K chat model rather than the 128K floor.
DEEP_RESEARCH_MODEL=local/qwen3.6-35b

# ── retrieval index (profile: index) ─────────────────────────────────────────
# Vectors for KloudChat's RAG. Off unless "index" is in COMPOSE_PROFILES; with
# it off, KloudChat falls back to the lexical search it already has.
INDEX_DB_USER=index
INDEX_DB_PASSWORD=index
# Embedding preference. The local model when the scheduler placed one, the
# commercial one when it did not. Neither is fatal.
INDEX_EMBED_MODELS=local/bge-m3,text-embedding-3-small
