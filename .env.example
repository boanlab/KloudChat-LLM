# Read top to bottom: what you provide, where the models run, how the stack is
# exposed, optional features, then the generated secrets (gen-env.sh).
# GPU node options are in .env.node.example.

# ━━━ 1. Keys you provide ━━━

# OpenRouter key: commercial models and the fallback for local ones. Required
# without a GPU node.
OPENROUTER_API_KEY=

# Hugging Face token for gated weight downloads
HF_TOKEN=

# NAVER Search API credentials, issued by NAVER API HUB (NAVER Cloud Platform).
# Both set turns on the naver engines in SearXNG; empty leaves them disabled.
# Quota: 775,000 calls a month shared by the search APIs, 50 a second per key.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ━━━ 2. Where the models run ━━━

# Deployed by the scheduler: GPU node SSH targets, comma separated (user@host or
# ssh_config alias). Empty skips node installation. The first target is the head
# node (retrieval, transcription); the rest are the pool (Flash-Next, the coder).
# Chat replicas land on any node with room.
# Example: VLLM_NODES=ops@gpu-1,ops@gpu-2
VLLM_NODES=

# Model ids to deploy, from scheduler/models.yaml. What does not fit a node is
# delegated to OpenRouter. qwen3.8-flash takes a pool node to itself, so it
# needs two nodes; on one node, leave it out (reachable as qwen/qwen3.8-flash).
VLLM_MODELS=qwen3.8-27b,qwen3.8-flash,bge-m3,bge-reranker-v2-m3,whisper-large-v3

# Run by you: vLLM servers, comma separated: http://host:port (asked what it
# serves) or id=http://host:port (registered even while down). Never written by
# the scheduler.
# Example: VLLM_ENDPOINTS=http://gpu-1:8001,http://gpu-2:8004
VLLM_ENDPOINTS=

# Run by you: transcription servers (vllm-whisper), comma separated URLs. The
# scheduler lists its own as whisper-large-v3 in VLLM_PLACED. With neither,
# dictation is off; audio is never sent outside.
WHISPER_URLS=

# Run by you: self-hosted image models (vllm-omni), served name=URL without /v1,
# comma-separated; set, it starts imagegen-shim (profile imagegen) and registers
# each name in LiteLLM as strict-local/<name> only (pictures never leave the
# boundary). The scheduler does not place image models.
# e.g. IMAGEGEN_BACKENDS=z-image-turbo=http://gpu-2:8091 → strict-local/z-image-turbo
# One model on several nodes: repeat its name, one name=URL per node; the shim
# sends each picture to the node with the fewest in flight and skips one that
# refuses the connection.
# The node runs them with ./scripts/manage-vllm-omni.sh (docker-compose.vllm-omni.yml).
IMAGEGEN_BACKENDS=

# Written by the scheduler from placement results: id=http://host:port per
# instance, the transcription model included
VLLM_PLACED=

# gpu-exporter port on every GPU node (docker-compose.vllm.yml). metrics-shim
# finds the nodes from VLLM_ENDPOINTS, VLLM_PLACED, WHISPER_URLS,
# IMAGEGEN_BACKENDS and VLLM_NODES.
GPU_EXPORTER_PORT=9835

# ━━━ 3. Exposure and sizing ━━━

# Gateway host port; the UI's backend URL is http://<this-host>:<port>
GATEWAY_PORT=8080

# Profiles: tools, models, index, whisper, ocr, imagegen. setup.sh appends
# whisper once a transcription backend is placed, imagegen once
# IMAGEGEN_BACKENDS is set.
COMPOSE_PROFILES=tools,models

# Images are pulled as <NS>/kloudchat-*:<TAG>
KLOUDCHAT_IMAGE_NS=boanlab
KLOUDCHAT_IMAGE_TAG=latest

# LiteLLM workers, ~600 MB of RAM each
LITELLM_NUM_WORKERS=4

# Cores the code-execution container may use across every sandbox
CODE_INTERPRETER_CPUS=4

# Model for iterative search (deep research); served at its native 256K context.
# A model id runs as local/<id>; a name with a slash (qwen/qwen3.8-27b, for an
# install without a GPU) is used as written.
DEEP_RESEARCH_MODEL=qwen3.8-27b

# Transcription: upload ceiling in MB (also set on the node for vllm-whisper) and
# transcriptions whisper-shim runs at once
WHISPER_MAX_UPLOAD_MB=100
WHISPER_MAX_CONCURRENT=8

# ━━━ 4. Retrieval index (profile: index) ━━━

# pgvector database for KloudChat's RAG. Without the profile KloudChat uses
# lexical search. Embeddings are local only (strict-local/bge-m3): a document is
# never sent outside.
INDEX_EMBED_MODELS=strict-local/bge-m3
# Second stage over the vector search, also local only; empty turns reranking off
INDEX_RERANK_MODEL=strict-local/bge-reranker-v2-m3

# ━━━ 5. Text from scanned pages (profile: ocr) ━━━

# PaddleOCR PP-OCRv5 (Korean) on CPU. KloudChat sends scanned PDF pages and
# document photos here; a page it cannot read with confidence goes to a
# strict-local vision model through LiteLLM, chosen in KloudChat's admin screen.
# Cores the service may use, pages read at once, ONNX threads per page
OCR_CPUS=4
OCR_CONCURRENCY=1
OCR_THREADS=4
# Memory cap, largest accepted document, render resolution
OCR_MEM_LIMIT=3g
OCR_MAX_BODY_MB=64
OCR_DPI=200

# ━━━ 6. Secrets (gen-env.sh replaces every change-me-* with a random value) ━━━

SEARXNG_SECRET_KEY=change-me-searxng-secret

LITELLM_DB_USER=kloudchat-litellm
LITELLM_DB_PASSWORD=change-me-litellm-db-password
LITELLM_MASTER_KEY=change-me-litellm-master-key

# Required by the gateway on every /tools/* request (header X-Tools-Key).
# KloudChat's API sends it: set the same value there as KCHAT_TOOLS_GATEWAY_KEY.
# Hex only (gen-env.sh writes 64 hex chars; by hand: openssl rand -hex 32).
# At least 32 characters, or the gateway denies every /tools request.
TOOLS_GATEWAY_KEY=change-me-tools-gateway-key

# Injected by the gateway into code execution requests
CODE_INTERPRETER_API_KEY=change-me-code-interpreter-key
CODE_INTERPRETER_MINIO_USER=code-interpreter
CODE_INTERPRETER_MINIO_PASSWORD=change-me-minio-password
CODE_INTERPRETER_MINIO_BUCKET=code-interpreter

# Injected by the gateway into document fetch requests
SCRAPER_API_KEY=change-me-scraper-key

# Retrieval index database (profile: index)
INDEX_DB_USER=index
INDEX_DB_PASSWORD=change-me-index-db-password
