# GPU node .env: read by docker-compose.vllm.yml and docker-compose.vllm-omni.yml
# on the node. Every value here is also the compose default, so a node needs none
# of them. install-vllm.sh creates the node's .env from this file when absent;
# setup.sh seeds a remote node's .env from the HF_ / VLLM_ / WHISPER_ /
# KLOUDCHAT_IMAGE_ keys of the orchestrator's .env.
# HF_TOKEN is set in the orchestrator's .env (weight downloads).
#
# MAX_LEN and GPU_UTIL are written per node by the placement step; the values
# here apply when placement is skipped. See docs/gpu-memory.md.

# vLLM image on the node (install-vllm.sh; default kloudchat-vllm:local), its
# upstream base and the base's resolved digest
VLLM_IMAGE=
VLLM_BASE_IMAGE=
VLLM_BASE_DIGEST=
VLLM_MODELS_ROOT=/var/lib/vllm/models

# Default chat. NVFP4; 32 KiB of KV per token (fp8)
VLLM_QWEN27B_DIR=qwen3.8-27b-nvfp4
VLLM_QWEN27B_GPU_UTIL=0.55
VLLM_QWEN27B_MAX_LEN=262144
VLLM_QWEN27B_MAX_BATCHED_TOKENS=16384
VLLM_QWEN27B_MAX_NUM_SEQS=128
# MTP speculative tokens per step
VLLM_QWEN27B_SPEC_TOKENS=5

# Quality and judging. MoE, NVFP4 body, FP8 PLE table off the GPU; 12 KiB of KV
# per token (fp8); a GB10 or RTX PRO 6000 node to itself
VLLM_QWENFLASH_DIR=qwen3.8-flash-next-nvfp4
VLLM_QWENFLASH_GPU_UTIL=0.81
VLLM_QWENFLASH_MAX_LEN=131072
VLLM_QWENFLASH_MAX_BATCHED_TOKENS=16384
VLLM_QWENFLASH_MAX_NUM_SEQS=16
# MTP speculative tokens per step
VLLM_QWENFLASH_SPEC_TOKENS=2
# PLE table storage (--engram-config). Empty: mapped from the checkpoint (GB10);
# {} on a discrete card (pinned host RAM), written by install-vllm.sh
VLLM_QWENFLASH_ENGRAM=

# Coding, larger. Hybrid attention, 12 KiB of KV per token; native 262K
VLLM_CODERNEXT_DIR=qwen3-coder-next
VLLM_CODERNEXT_GPU_UTIL=0.85
VLLM_CODERNEXT_MAX_LEN=262144

# Transcription (openai/whisper-large-v3 on vLLM); upload ceiling in MB, also
# enforced by the compose host's shim, and transcriptions the shim runs at once
VLLM_WHISPER_DIR=whisper-large-v3
WHISPER_MAX_UPLOAD_MB=100
WHISPER_MAX_CONCURRENT=8

# Self-hosted image models (docker-compose.vllm-omni.yml, manage-vllm-omni.sh):
# vllm-omni image, checkpoint directories under VLLM_MODELS_ROOT, and the cards
# they see. z-image-turbo serves on :8091, qwen-image-2512 on :8092.
VLLM_OMNI_IMAGE=vllm/vllm-omni:v0.30.0
VLLM_OMNI_ZIMAGE_DIR=z-image-turbo
VLLM_OMNI_QWENIMAGE_DIR=qwen-image-2512
VLLM_OMNI_DEVICES=all
